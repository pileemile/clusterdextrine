{
  "name": "clusterdextrine",
  "version": "1.0.0",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "loadtest": "K6_WEB_DASHBOARD=true K6_WEB_DASHBOARD_EXPORT=rapport.html k6 run loadtest.js",
    "loadtest:ci": "K6_WEB_DASHBOARD=true K6_WEB_DASHBOARD_EXPORT=rapport.html VUS=20 DURATION=20s k6 run loadtest.js",
    "test": "node --test",
    "seed": "node scripts/seed-tenants.js",
    "admin:grant": "node scripts/grant-admin.js",
    "e2e": "cypress run",
    "tracing:build": "esbuild otel-web/tracing-entry.js --bundle --format=iife --outfile=public/tracing.js --platform=browser",
    "agenda:build": "npm --prefix agenda-web ci && agenda-web/node_modules/.bin/esbuild agenda-web/main.js --bundle --minify --format=iife --outfile=public/agenda.min.js --platform=browser --alias:vue=./agenda-web/node_modules/vue/dist/vue.esm-bundler.js --define:process.env.NODE_ENV=\\\"production\\\" --define:__VUE_OPTIONS_API__=true --define:__VUE_PROD_DEVTOOLS__=false --define:__VUE_PROD_HYDRATION_MISMATCH_DETAILS__=false",
    "coverage": "mkdir -p coverage && node --test --experimental-test-coverage --test-reporter=spec --test-reporter-destination=stdout --test-reporter=lcov --test-reporter-destination=coverage/lcov.info && node scripts/lcov-relative.js",
    "postinstall": "prisma generate",
    "db:migrate": "prisma migrate dev"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "@opentelemetry/api": "^1.10.0",
    "@opentelemetry/auto-instrumentations-node": "^0.83.1",
    "@opentelemetry/sdk-node": "^0.301.2",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.5",
    "helmet": "^8.3.0",
    "mongoose": "^9.12.3",
    "pdfkit": "^0.21.0",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1",
    "cypress": "^16.3.0",
    "dotenv": "^18.0.10",
    "mongodb-memory-server": "^11.3.0",
    "prisma": "^7.10.1",
    "supertest": "^7.3.2",
    "unpdf": "^2.2.1"
  },
  "overrides": {
    "glob": "14.0.6",
    "minimatch": "11.0.9"
  }
}
