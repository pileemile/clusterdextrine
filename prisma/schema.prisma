generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// Les deux tokens sont chiffrés (AES-256-GCM, voir src/google/crypto.js).
model GoogleCredential {
  id           String   @id @default(uuid())
  userId       String   @unique
  accessToken  String
  refreshToken String
  expiresAt    DateTime
  scopes       String[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}
